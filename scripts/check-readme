#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause
#
# Fails if the README's quickstart differs from examples/Sources/Quickstart,
# so the README can never rot, or if the README links a dev or API host.
set -euo pipefail
cd "$(dirname "$0")/.."

readme="$(awk '/^## Quickstart/{q=1} q && /^```swift/{f=1; next} f && /^```/{exit} f' README.md)"
example="$(awk 'BEGIN{b=0} b==0 && /^(\/\/|$)/ {next} {b=1; print}' examples/Sources/Quickstart/main.swift)"
if [[ "$readme" != "$example" ]]; then
  diff <(echo "$readme") <(echo "$example") || true
  echo "error: README quickstart differs from examples/Sources/Quickstart/main.swift" >&2
  exit 1
fi
if grep -nE 'https?://(api\.oureawx\.com|[a-z0-9.-]*dev[a-z0-9.-]*\.oureawx\.com|localhost)' README.md; then
  echo "error: the README links an API or dev host" >&2
  exit 1
fi
echo "README quickstart matches the example"
